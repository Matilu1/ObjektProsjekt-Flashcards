<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="flashcards.ProjectController">
   <children>
      <VBox layoutY="-1.0" prefHeight="400.0" prefWidth="600.0" AnchorPane.topAnchor="-1.0">
         <children>
            <Label prefHeight="44.0" prefWidth="284.0" text="Mine fag">
               <font>
                  <Font name="Times New Roman" size="30.0" />
               </font>
            </Label>
            <HBox prefHeight="73.0" prefWidth="600.0">
               <children>
                  <Button fx:id="addSubjectButton" mnemonicParsing="false" onAction="#addSubject" text="Nytt fag:">
                     <font>
                        <Font name="Times New Roman Bold" size="13.0" />
                     </font>
                  </Button>
                  <TextField fx:id="subjectNameField" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" prefHeight="357.0" prefWidth="474.0">
               <content>
                  <VBox fx:id="subjectList" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
